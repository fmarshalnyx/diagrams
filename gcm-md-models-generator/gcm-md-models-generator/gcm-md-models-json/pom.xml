<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.gcm.md</groupId>
    <artifactId>gcm-md-models-generator</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>gcm-md-models-json</artifactId>
  <name>GCM MD Models - JSON translators + schemas</name>
  <description>Generated SBE-to-JSON translators, JSON Schemas and AsyncAPI document for gcm-md messages</description>

  <dependencies>
    <dependency><groupId>com.gcm.md</groupId><artifactId>gcm-md-models-sbe</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.agrona</groupId><artifactId>agrona</artifactId></dependency>
    <!-- generator runs at build time only; provided keeps it off the runtime classpath -->
    <dependency><groupId>com.gcm.md</groupId><artifactId>gcm-md-models-json-gen</artifactId><version>${project.version}</version><scope>provided</scope></dependency>

    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.networknt</groupId><artifactId>json-schema-validator</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-json-artifacts</id>
            <phase>generate-sources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>com.gcm.md.models.jsongen.JsonGenMain</mainClass>
              <classpathScope>compile</classpathScope>
              <arguments>
                <argument>${project.basedir}/../gcm-md-models-sbe/src/main/resources/gcm-md-sbe.xml</argument>
                <argument>${project.build.directory}/generated-sources/json</argument>
                <argument>${project.build.directory}/generated-resources</argument>
                <argument>com.gcm.md.models.json.translators</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-json-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources><source>${project.build.directory}/generated-sources/json</source></sources>
            </configuration>
          </execution>
          <execution>
            <id>add-json-resources</id>
            <phase>generate-resources</phase>
            <goals><goal>add-resource</goal></goals>
            <configuration>
              <resources><resource><directory>${project.build.directory}/generated-resources</directory></resource></resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
