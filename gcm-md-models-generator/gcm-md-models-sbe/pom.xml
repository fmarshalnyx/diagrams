<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.gcm.md</groupId>
    <artifactId>gcm-md-models-generator</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>gcm-md-models-sbe</artifactId>
  <name>GCM MD Models - SBE codecs</name>
  <description>Java SBE encoders/decoders generated from gcm-md-sbe.xml by real-logic sbe-tool</description>

  <dependencies>
    <dependency><groupId>org.agrona</groupId><artifactId>agrona</artifactId></dependency>
    <!-- Needed only to run SbeTool at generate-sources time -->
    <dependency><groupId>uk.co.real-logic</groupId><artifactId>sbe-tool</artifactId><scope>provided</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-sbe-codecs</id>
            <phase>generate-sources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>uk.co.real_logic.sbe.SbeTool</mainClass>
              <classpathScope>compile</classpathScope>
              <arguments>
                <argument>${project.basedir}/src/main/resources/gcm-md-sbe.xml</argument>
              </arguments>
              <systemProperties>
                <systemProperty><key>sbe.output.dir</key><value>${project.build.directory}/generated-sources/sbe</value></systemProperty>
                <systemProperty><key>sbe.target.language</key><value>Java</value></systemProperty>
                <systemProperty><key>sbe.validation.stop.on.error</key><value>true</value></systemProperty>
              </systemProperties>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-sbe-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources><source>${project.build.directory}/generated-sources/sbe</source></sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
