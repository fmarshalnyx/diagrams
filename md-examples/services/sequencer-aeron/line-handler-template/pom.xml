<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>gcm.md</groupId>
        <artifactId>gcm-md-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../../build/gcm-md-parent</relativePath>
    </parent>

    <artifactId>line-handler-template</artifactId>
    <packaging>jar</packaging>

    <properties>
        <!-- Overrides the parent POM's default (true) - this is one of the 4 modules that
             actually wants an image built. A global -Djib.skip=true (the build/integration CI
             jobs use this) still wins over this module-level default, per normal Maven property
             precedence - see the parent POM's own comment on why this is a property and not a
             literal <skip> value in this module's <configuration> below. -->
        <jib.skip>false</jib.skip>
    </properties>

    <!-- services/sequencer-aeron/line-handler-template (implementation-steps.md Milestone 5B):
         reference Spring Boot service demonstrating how a real line handler wires an
         IngressTransport (libs/ingress-transport), selects between the Aeron cluster transport
         (libs/cluster-client) and the NATS transport (libs/nats-egress's NatsIngressTransport) by
         config, and relays messages with the retry/crash-recovery contract both transports
         require. Not itself deployed to a real feed — see README.md for what to copy vs keep
         as-is. Replaces the ingress-shim strangler service the original design planned (see
         libs/ingress-transport's package-info for why). -->

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- Actuator alone has no embedded server; web is required for the /actuator/health
             HTTP endpoint readiness/liveness probes target (see nats-bridge's identical comment). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.agrona</groupId>
            <artifactId>agrona</artifactId>
        </dependency>
        <dependency>
            <groupId>io.aeron</groupId>
            <artifactId>aeron-all</artifactId>
        </dependency>
        <dependency>
            <groupId>io.nats</groupId>
            <artifactId>jnats</artifactId>
        </dependency>
        <dependency>
            <groupId>gcm.md</groupId>
            <artifactId>ingress-transport</artifactId>
        </dependency>
        <dependency>
            <groupId>gcm.md</groupId>
            <artifactId>cluster-client</artifactId>
        </dependency>
        <dependency>
            <groupId>gcm.md</groupId>
            <artifactId>nats-egress</artifactId>
        </dependency>

        <!-- Test-only: builds realistic SBE-shaped fixture buffers for UpstreamRelayTest. Main
             code never depends on md-models-sbe — it treats the upstream payload as opaque bytes
             and only ever pokes the one configured sourceSeqNum offset, matching this repo's
             "never decode SBE outside a codec-permitted module" hot-path discipline. -->
        <dependency>
            <groupId>gcm.md</groupId>
            <artifactId>md-models-sbe</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>line-handler-template</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Container image (design §10, §11) — kept for parity with the other services even
                 though this module is a template, not something normally deployed as-is. -->
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>build-image</id>
                        <phase>package</phase>
                        <goals>
                            <goal>dockerBuild</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- <skip> deliberately not set here - inherited from pluginManagement as
                         ${jib.skip}, resolved via this module's own <properties> above. -->
                    <from>
                        <image>eclipse-temurin:25-jre-alpine</image>
                    </from>
                    <to>
                        <image>gcm-md/line-handler-template</image>
                        <tags>
                            <tag>local</tag>
                        </tags>
                    </to>
                    <container>
                        <mainClass>gcm.md.linehandlertemplate.LineHandlerTemplateApplication</mainClass>
                        <jvmFlags>
                            <jvmFlag>-XX:+UseZGC</jvmFlag>
                            <jvmFlag>-XX:+AlwaysPreTouch</jvmFlag>
                        </jvmFlags>
                        <ports>
                            <port>8080</port>
                        </ports>
                        <user>1000:1000</user>
                    </container>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
