<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>gcm.md</groupId>
        <artifactId>gcm-md-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../build/gcm-md-parent</relativePath>
    </parent>

    <artifactId>sequencer-core</artifactId>
    <packaging>jar</packaging>

    <!-- libs/sequencer-core (design §4): the transport-agnostic stamping engine — the factored-
         out heart of the phase-1 sequencer and the body of the phase-2 clustered service.
         Dependencies: Agrona only. No Aeron, no NATS, no Spring, no clocks — StampingEngine is a
         pure function of (current state, input buffer, supplied time), so it is identically
         testable here and embeddable in services/sequencer-aeron/cluster-node (Milestone 2)
         without pulling in any infrastructure. -->

    <dependencies>
        <dependency>
            <groupId>org.agrona</groupId>
            <artifactId>agrona</artifactId>
        </dependency>

        <!-- Test only: SBE codecs for the offset-contract tests (§12.1), proving configured
             offsets land in the fields the generated v4 codecs expect. -->
        <dependency>
            <groupId>gcm.md</groupId>
            <artifactId>md-models-sbe</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- §3.3: rules (no services/* dependency, no Spring dependency) are managed
                 centrally in build/gcm-md-parent's pluginManagement; this bare declaration
                 activates them for this module. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
