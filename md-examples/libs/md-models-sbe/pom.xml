<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>gcm.md</groupId>
        <artifactId>gcm-md-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../build/gcm-md-parent</relativePath>
    </parent>

    <artifactId>md-models-sbe</artifactId>
    <packaging>jar</packaging>

    <!-- SBE-generated codecs are test scope everywhere in the reactor except
         services/sequencer-aeron/loadgen (runtime fixtures); enforced in Milestone 1 (§3.3). -->
    <dependencies>
        <dependency>
            <groupId>org.agrona</groupId>
            <artifactId>agrona</artifactId>
        </dependency>
        <dependency>
            <groupId>uk.co.real-logic</groupId>
            <artifactId>sbe-tool</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-sbe-codecs</id>
                        <phase>generate-sources</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>uk.co.real_logic.sbe.SbeTool</mainClass>
                            <classpathScope>compile</classpathScope>
                            <arguments>
                                <argument>${project.basedir}/../../schema/md-models-sbe-v4.xml</argument>
                            </arguments>
                            <systemProperties>
                                <systemProperty><key>sbe.output.dir</key><value>${project.build.directory}/generated-sources/sbe</value></systemProperty>
                                <systemProperty><key>sbe.target.language</key><value>Java</value></systemProperty>
                                <systemProperty><key>sbe.validation.stop.on.error</key><value>true</value></systemProperty>
                            </systemProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-sbe-sources</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration>
                            <sources><source>${project.build.directory}/generated-sources/sbe</source></sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- §3.3: rules (no services/* dependency, no Spring dependency) are managed
                 centrally in build/gcm-md-parent's pluginManagement; this bare declaration
                 activates them for this module. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>